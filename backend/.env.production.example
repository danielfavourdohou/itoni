# Production environment for the Render web service. Copy these into
# Render -> Environment. Never commit real values; this file holds placeholders only.
# Frontend is on Vercel and proxies /api, /admin and /static to this service.

# --- Python ---
PYTHON_VERSION=3.12.7

# --- Django ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=false
# The Render host (Vercel forwards requests to it). Add the Vercel domain too if you like.
DJANGO_ALLOWED_HOSTS=your-service.onrender.com
# The browser's Origin is the Vercel domain, not the Render host.
CSRF_TRUSTED_ORIGINS=https://your-app.vercel.app
# Seconds browsers remember to use https for the Render host. 3600 is a safe start.
DJANGO_HSTS_SECONDS=3600
# Keep DB connections open between requests (seconds).
DJANGO_CONN_MAX_AGE=600

# --- Database ---
# Render Postgres "Internal Database URL" (same region as this service).
DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- NKENNEAi ---
NKENNE_BASE_URL=https://developers-api.nkenne.ai
NKENNE_API_KEY=replace-with-your-key
# false = real API calls. Every page then shows live data and no MOCK banner.
NKENNE_MOCK=false
NKENNE_TIMEOUT_TRANSLATE=30
# Vercel cuts proxied requests at 120 s: 3 attempts x 35 s + backoff stays under it.
NKENNE_TIMEOUT_AUDIO=35
# Part of the audio cache key: changing it means paying for every clip again.
NKENNE_VOICE_SWAHILI=asha
NKENNE_TTS_SPEAKING_RATE=0.9

# Patient replies: stt = Speech-to-Text then Text-to-Text (default; Speech Translation currently
# returns translated speech, not text). st = try Speech Translation first.
NKENNE_REPLY_ROUTE=stt

# --- App ---
ITONI_INSTRUCTION_TTL_DAYS=30
ITONI_REPLY_MAX_BYTES=5242880
ITONI_REPLY_MAX_SECONDS=60
ITONI_REPLY_RATE_PER_HOUR=10
# Patient links and QR codes must point at the Vercel domain.
FRONTEND_BASE_URL=https://your-app.vercel.app

# Clinic shown to patients. Leave the phone empty to hide the call button:
# never use a made-up number, it could belong to a real person.
ITONI_CLINIC_NAME=
ITONI_CLINIC_PHONE=

# API reference at /api/docs/ (read-only). Public for the hackathon submission;
# false hides it from everyone but logged-in staff.
ITONI_API_DOCS_PUBLIC=true
