# Copy to .env and fill in. Never commit .env.

# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# Database (leave unset locally to use SQLite)
# DATABASE_URL=postgres://user:password@localhost:5432/itoni

# NKENNEAi
NKENNE_BASE_URL=https://developers-api.nkenne.ai
NKENNE_API_KEY=
# true = no network calls, fake responses (use while building)
NKENNE_MOCK=true
NKENNE_TIMEOUT_TRANSLATE=30
NKENNE_TIMEOUT_AUDIO=60
# Set after calling GET /api/tts/v1/{language}/voices
NKENNE_VOICE_SWAHILI=
NKENNE_TTS_SPEAKING_RATE=0.9

# App
ITONI_INSTRUCTION_TTL_DAYS=30
ITONI_REPLY_MAX_BYTES=5242880
ITONI_REPLY_MAX_SECONDS=60
ITONI_REPLY_RATE_PER_HOUR=10
